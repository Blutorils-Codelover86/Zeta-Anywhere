# Base URL for future Zeta Anywhere service.
ZETA_API_BASE_URL=https://example-zeta-service.invalid

# true = mock/dev services, false = remote API services.
ZETA_MOCK_MODE=true

# Pairing code validity default in seconds.
ZETA_PAIRING_TTL_SECONDS=600

# Future WebRTC configuration placeholders (do not commit credentials)
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=
